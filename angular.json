{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "kendoGridState": {
      "projectType": "library",
      "root": "projects/kendo-grid-state",
      "sourceRoot": "projects/kendo-grid-state/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/kendo-grid-state/tsconfig.lib.json",
            "project": "projects/kendo-grid-state/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/kendo-grid-state/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/kendo-grid-state/src/test.ts",
            "tsConfig": "projects/kendo-grid-state/tsconfig.spec.json",
            "karmaConfig": "projects/kendo-grid-state/karma.conf.js",
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/kendo-grid-state/**/*.ts",
              "projects/kendo-grid-state/**/*.html"
            ]
          }
        }
      }
    },
    "example": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/example",
      "sourceRoot": "projects/example/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/example",
            "index": "projects/example/src/index.html",
            "browser": "projects/example/src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "projects/example/tsconfig.app.json",
            "assets": [
              "projects/example/src/favicon.ico",
              {
                "glob": "**/*",
                "input": "projects/example/src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "node_modules/@progress/kendo-theme-default/dist/all.css",
              "node_modules/milligram/dist/milligram.min.css",
              "projects/example/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/example/src/environments/environment.ts",
                  "with": "projects/example/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "example:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "example:build:production"
            },
            "development": {
              "buildTarget": "example:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "example:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/example/src/**/*.ts",
              "projects/example/src/**/*.html"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/example/src/test.ts",
            "tsConfig": "projects/example/tsconfig.spec.json",
            "karmaConfig": "projects/example/karma.conf.js",
            "assets": [
              "projects/example/src/favicon.ico",
              {
                "glob": "**/*",
                "input": "projects/example/src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "projects/example/src/styles.css"
            ],
            "scripts": [],
            "polyfills": [
              "zone.js",
              "zone.js/testing",
              "@angular/localize/init"
            ]
          }
        }
      }
    }
  }
}
